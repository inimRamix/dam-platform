# Postgres
POSTGRES_USER=dam
POSTGRES_PASSWORD=damPassword
POSTGRES_DB=damdb

# Database
DATABASE_URL=postgresql+asyncpg://dam:damPassword@postgres:5432/damdb

# RabbitMQ
RABBITMQ_DEFAULT_USER=dam
RABBITMQ_DEFAULT_PASS=damPassword

# MinIO
MINIO_ROOT_USER=dam
MINIO_ROOT_PASSWORD=damPassword

# ElasticSearch
ES_DISCOVERY_TYPE=single-node
ES_SECURITY_ENABLED=false
ES_HEAP_MIN=512m
ES_HEAP_MAX=512m

# JWT
JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256

# SMTP
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=dam
SMTP_PASSWORD=damPassword
SMTP_FROM=mailhog@dam.local

# Operating mode (local/production)
DEPLOY_MODE=local
