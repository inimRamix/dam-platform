# Postgres
POSTGRES_USER=dam
POSTGRES_PASSWORD=damPassword
POSTGRES_DB=damdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_DEFAULT_USER=dam
RABBITMQ_DEFAULT_PASS=damPassword

# MinIO
MINIO_ROOT_USER=dam
MINIO_ROOT_PASSWORD=damPassword

# ElasticSearch
ES_DISCOVERY_TYPE=single-node
ES_SECURITY_ENABLED=false
ES_HEAP_MIN=512m
ES_HEAP_MAX=512m

# JWT
JWT_SECRET_KEY=your-secret-key

# SMTP
SMTP_USERNAME=your-username
SMTP_PASSWORD=your-password
SMTP_HOST=
SMTP_PORT=

# Operating mode (local/production)
DEPLOY_MODE=local
