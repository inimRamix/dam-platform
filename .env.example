# Postgres
POSTGRES_USER=dam
POSTGRES_PASSWORD=damPassword
POSTGRES_DB=damdb

# Database
APP_CONFIG__DB__URL=postgresql+asyncpg://dam:damPassword@postgres:5432/damdb

# RabbitMQ
RABBITMQ_DEFAULT_USER=dam
RABBITMQ_DEFAULT_PASS=damPassword

# MinIO
MINIO_ROOT_USER=dam
MINIO_ROOT_PASSWORD=damPassword

# ElasticSearch
ES_DISCOVERY_TYPE=single-node
ES_SECURITY_ENABLED=false
ES_HEAP_MIN=512m
ES_HEAP_MAX=512m

# JWT
APP_CONFIG__JWT__SECRET_KEY=your-secret-key
APP_CONFIG__JWT__ALGORITHM=HS256

# SMTP
APP_CONFIG__SMTP__HOST=mailhog
APP_CONFIG__SMTP__PORT=1025
APP_CONFIG__SMTP__USERNAME=dam
APP_CONFIG__SMTP__PASSWORD=damPassword
APP_CONFIG__SMTP__FROM_EMAIL=mailhog@dam.local

# Operating mode (local/production)
APP_CONFIG__DEPLOY_MODE=local

APP_CONFIG__APP_BASE_URL="http://localhost:8000"
